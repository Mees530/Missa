# Password your friends use to open the app
APP_PASSWORD=beers

# Secret for signing session cookies — change this to something random!
SESSION_SECRET=change-me-to-something-random

# Where to store the SQLite database file
# On Railway, add a persistent volume at /data and set this:
# DATA_DIR=/data
DATA_DIR=./data

# Port (Railway/Render set this automatically)
PORT=3000
