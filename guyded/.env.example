# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_api_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=your_custom_verify_token_here

# Supabase — use the direct connection string (port 5432), not the pooler,
# so asyncpg's prepared-statement cache works correctly.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
